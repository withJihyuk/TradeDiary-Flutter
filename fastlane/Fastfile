opt_out_usage

platform :android do
  desc "Submit the signed AAB to Google Play production"
  lane :submit do
    upload_to_play_store(
      package_name: "com.jihyuk.potatodiary",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("SUPPLY_JSON_KEY_DATA"),
      track: "production",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

platform :ios do
  desc "Build and submit the app to App Store review"
  lane :submit do
    project_root = File.expand_path("..", __dir__)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true,
    )

    setup_ci
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
    )
    build_app(
      workspace: File.join(project_root, "ios/Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: "D4LL5QF543",
      output_directory: File.join(project_root, "build/ios/ipa"),
      output_name: "trade_diary.ipa",
      export_options: {
        provisioningProfiles: {
          "com.example.tradeDiary" => "match AppStore com.example.tradeDiary",
          "com.example.tradeDiary.PotatoDiaryWidget" => "match AppStore com.example.tradeDiary.PotatoDiaryWidget",
        },
      },
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.example.tradeDiary",
      ipa: File.join(project_root, "build/ios/ipa/trade_diary.ipa"),
      metadata_path: File.join(project_root, "fastlane/metadata"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
    )
  end
end
